---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";

const title = "Swypik — One ecosystem for discovery, commerce and local AI";
const description = "Swypik brings video-native commerce, Ilaria local AI and a native agentic desktop shell into one connected ecosystem.";

const apps = [
  { name: "Search", label: "Find across your world", icon: "⌕" },
  { name: "Studio", label: "Create with AI beside you", icon: "✦" },
  { name: "Tasks", label: "Turn intent into action", icon: "✓" },
  { name: "Connect", label: "Devices and people", icon: "◌" },
  { name: "Shield", label: "Privacy and control", icon: "◆" },
  { name: "Wallet", label: "Commerce at system level", icon: "◇" },
];

const faq = [
  ["Is Swypik available now?", "The Swypik web product is already running. The mobile app and the broader ecosystem are still in active development, so the public launch experience is being rolled out in stages."],
  ["What is Ilaria?", "Ilaria is Swypik’s local-first AI research stack: a Romanian-first, English-capable language system with its own Go inference engine, tool-use work and one-shot memory research. It is not presented as a replacement for frontier cloud models."],
  ["Is SwypikOS a full operating system today?", "Not yet. The current verified implementation is a native Windows desktop shell connected to Ilaria. The long-term direction is a broader agentic computing layer, but the site deliberately separates what exists today from the roadmap."],
  ["Do you sell my data?", "The early-access form is designed to collect only what is needed to contact you about Swypik. The final production deployment should be reviewed against the privacy policy and configured with the correct legal entity and retention details before launch."],
];
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Swypik",
      url: "https://swypik.com",
      logo: "https://swypik.com/favicon.svg",
      description,
    })} />
  </Fragment>

  <header class="site-header">
    <div class="shell nav">
      <Brand />
      <nav aria-label="Primary navigation">
        <a href="#swypik">Swypik</a>
        <a href="#ilaria">Ilaria</a>
        <a href="#os">OS</a>
        <a href="#ecosystem">Ecosystem</a>
      </nav>
      <a class="nav-cta" href="#early-access">Get early access <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="main-content">
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="shell hero-grid">
        <div class="hero-copy reveal is-visible">
          <span class="eyebrow">Swypik ecosystem · early access</span>
          <h1>The internet.<br /><span class="gradient-text">Rebuilt around you.</span></h1>
          <p>
            Watch, discover, buy, create and work with an AI that can stay close to your data.
            Swypik connects social commerce, Ilaria and a native agentic shell into one system.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#early-access">Join early access <span>→</span></a>
            <a class="button button-ghost" href="#ecosystem">See how it connects</a>
          </div>
          <div class="trust-row" aria-label="Product principles">
            <span>Local-first AI</span>
            <span>Native software</span>
            <span>Built for Europe</span>
          </div>
        </div>

        <div class="ecosystem-stage reveal is-visible" aria-label="Swypik ecosystem preview">
          <div class="orb orb-one" aria-hidden="true"></div>
          <div class="orb orb-two" aria-hidden="true"></div>

          <div class="signal-card signal-ai glass">
            <div class="signal-head"><span class="signal-dot"></span>Ilaria memory</div>
            <p>“Remember: my delivery preference is evening.”</p>
            <div class="memory-chip">Stored locally · one-shot memory</div>
          </div>

          <div class="phone-shell">
            <div class="phone-screen">
              <div class="phone-top"><span>swypik</span><span>⌕</span></div>
              <div class="video-scene">
                <div class="scene-copy">
                  <span class="scene-tag">For you</span>
                  <h3>Discover what moves you.</h3>
                  <p>Video → product → checkout, without leaving the flow.</p>
                </div>
                <div class="product-float">
                  <div class="product-thumb"></div>
                  <div><strong>Studio Lamp</strong><span>€79 · 4.9 ★</span></div>
                  <button aria-label="Add Studio Lamp">+</button>
                </div>
              </div>
              <div class="phone-nav"><span>⌂</span><span>⌕</span><span class="create">+</span><span>□</span><span>○</span></div>
            </div>
          </div>

          <div class="signal-card signal-os glass">
            <div class="os-mini-head"><span></span><span></span><span></span></div>
            <div class="os-mini-body">
              <div class="os-mini-command"><b>Ask Ilaria</b><span>Open my project and find the failing test.</span></div>
              <div class="os-mini-result">Ready to inspect locally.</div>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-proof shell reveal">
        <div><strong>01</strong><span>One identity</span></div>
        <div><strong>02</strong><span>One intelligence layer</span></div>
        <div><strong>03</strong><span>Three connected surfaces</span></div>
      </div>
    </section>

    <section class="section product-section" id="swypik">
      <div class="shell">
        <p class="section-kicker reveal">01 · Swypik</p>
        <h2 class="section-title reveal">Video that doesn’t end at <span class="gradient-text">“like.”</span></h2>
        <p class="section-copy reveal">
          Swypik is social discovery built around action: watch a clip, understand the product,
          move to checkout and keep going. The web product is already live; native mobile is being
          prepared as a separate launch track.
        </p>

        <div class="feature-grid">
          <article class="feature feature-large glass reveal">
            <div class="feature-topline"><span>Discovery engine</span><span class="status-dot">Live web</span></div>
            <div class="feed-mock">
              <div class="feed-card feed-purple"><span>01</span><strong>Watch</strong></div>
              <div class="feed-card feed-black"><span>02</span><strong>Understand</strong></div>
              <div class="feed-card feed-white"><span>03</span><strong>Buy</strong></div>
            </div>
            <h3>Commerce stays inside the story.</h3>
            <p>Products, creators and checkout are designed as one continuous discovery loop.</p>
          </article>

          <article class="feature glass reveal">
            <div class="icon-box">↗</div>
            <h3>Creator-native</h3>
            <p>Discovery and selling meet in the same interface instead of living in separate funnels.</p>
          </article>

          <article class="feature glass reveal">
            <div class="icon-box">◎</div>
            <h3>AI-ready by design</h3>
            <p>Ranking, moderation and assistance can connect to the same event and commerce layer.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section ilaria-section" id="ilaria">
      <div class="shell split">
        <div>
          <p class="section-kicker reveal">02 · Ilaria</p>
          <h2 class="section-title reveal">An AI that can remember what your world <span class="gradient-text">just changed.</span></h2>
          <p class="section-copy reveal">
            Ilaria is a local-first AI research stack with a Go inference engine, Romanian-first language
            work, English capability, tool use and one-shot memory research. It is designed to become the
            intelligence layer inside Swypik — without pretending to be a frontier cloud model.
          </p>
          <div class="pill-row reveal">
            <span class="pill">Go inference engine</span>
            <span class="pill">Romanian + English</span>
            <span class="pill">One-shot memory</span>
            <span class="pill">Local-first</span>
          </div>
        </div>

        <div class="terminal glass reveal" aria-label="Ilaria product demo">
          <div class="terminal-bar">
            <div><span></span><span></span><span></span></div>
            <strong>Ilaria · local</strong>
            <small>● ready</small>
          </div>
          <div class="conversation">
            <div class="turn user"><span>You</span><p>Remember that my default delivery window is 18:00–21:00.</p></div>
            <div class="turn ai"><span>Ilaria</span><p>I’ll keep that as your delivery preference.</p><em>memory.write → 1 fact</em></div>
            <div class="terminal-divider"></div>
            <div class="turn user"><span>You · later</span><p>When should the next order arrive?</p></div>
            <div class="turn ai"><span>Ilaria</span><p>Your saved preference is evening, between 18:00 and 21:00.</p><em>memory.read → matched preference</em></div>
          </div>
          <div class="terminal-foot"><span>Runs can stay on your machine</span><span>⌁</span></div>
        </div>
      </div>
    </section>

    <section class="section os-section" id="os">
      <div class="shell">
        <div class="os-heading">
          <div>
            <p class="section-kicker reveal">03 · SwypikOS</p>
            <h2 class="section-title reveal">AI with a desktop to <span class="gradient-text">act on.</span></h2>
          </div>
          <p class="section-copy reveal">
            The current verified implementation is a native Windows desktop shell connected to Ilaria.
            The ambition is broader: a computing layer where the assistant can understand context,
            use tools and help complete work instead of living in a browser tab.
          </p>
        </div>

        <div class="desktop glass reveal">
          <div class="desktop-top">
            <div class="desktop-brand"><img src="/favicon.svg" alt="" /><strong>SwypikOS</strong></div>
            <div class="desktop-state"><span>Local AI</span><b>13:01</b></div>
          </div>
          <div class="desktop-body">
            <aside>
              <div class="avatar">IL</div>
              <span>Ilaria</span>
              <small>Local intelligence</small>
              <div class="side-line"></div>
              <p>“What do you want to get done?”</p>
            </aside>
            <div class="app-grid">
              {apps.map((app) => (
                <div class="app-card">
                  <div class="app-icon">{app.icon}</div>
                  <strong>{app.name}</strong>
                  <span>{app.label}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="desktop-caption">
            <span class="status-dot">Current: Windows-native shell</span>
            <span>Roadmap: broader agentic computing platform</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section ecosystem-section" id="ecosystem">
      <div class="shell">
        <p class="section-kicker reveal">One ecosystem</p>
        <h2 class="section-title reveal">Discovery becomes context.<br />Context becomes <span class="gradient-text">action.</span></h2>
        <div class="loop-grid reveal">
          <div class="loop-step">
            <span class="loop-index">01</span>
            <h3>Discover</h3>
            <p>Swypik learns from what people watch, search and buy.</p>
          </div>
          <div class="loop-arrow">→</div>
          <div class="loop-step">
            <span class="loop-index">02</span>
            <h3>Remember</h3>
            <p>Ilaria can keep useful local context and preferences close.</p>
          </div>
          <div class="loop-arrow">→</div>
          <div class="loop-step">
            <span class="loop-index">03</span>
            <h3>Act</h3>
            <p>The agentic shell becomes a surface where intent can turn into work.</p>
          </div>
        </div>

        <div class="manifesto glass reveal">
          <span class="manifesto-mark">S</span>
          <p>One account. One intelligence layer. Multiple surfaces — designed to feel like one product.</p>
        </div>
      </div>
    </section>

    <section class="section early-section" id="early-access">
      <div class="shell early-card glass reveal">
        <div>
          <span class="eyebrow">Private early access</span>
          <h2>Be there before the ecosystem opens up.</h2>
          <p>Join the launch list for Swypik, Ilaria and the next SwypikOS previews. No fake countdowns. No daily spam.</p>
        </div>
        <form id="waitlist-form" class="waitlist" action="/api/waitlist" method="post">
          <label for="email">Email address</label>
          <div class="field-row">
            <input id="email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required />
            <button type="submit">Join early access <span>→</span></button>
          </div>
          <div class="trap" aria-hidden="true">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <label class="consent">
            <input name="consent" type="checkbox" value="yes" required />
            <span>I want launch and product updates from Swypik. I can unsubscribe at any time.</span>
          </label>
          <p class="form-note">By joining, you agree to the <a href="/privacy/">Privacy Policy</a>.</p>
          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="section faq-section">
      <div class="shell faq-grid">
        <div>
          <p class="section-kicker reveal">FAQ</p>
          <h2 class="section-title reveal">Straight answers.<br /><span class="gradient-text">No vaporware copy.</span></h2>
        </div>
        <div class="faq-list">
          {faq.map(([question, answer]) => (
            <details class="reveal">
              <summary>{question}<span aria-hidden="true">+</span></summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="shell footer-grid">
      <div>
        <Brand />
        <p>Video-native commerce. Local-first intelligence. Agentic computing.</p>
      </div>
      <div class="footer-links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/contact/">Contact</a>
        <a href="#early-access">Early access</a>
      </div>
      <div class="footer-meta">© {new Date().getFullYear()} Swypik. Product roadmap subject to change.</div>
    </div>
  </footer>

  <script>
    type WaitlistResponse = {
      error?: string;
      existing?: boolean;
    };

    const form = document.querySelector<HTMLFormElement>("#waitlist-form");
    const status = document.querySelector<HTMLElement>("#form-status");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status) return;

      const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
      const formData = new FormData(form);
      const payload = {
        email: String(formData.get("email") ?? ""),
        company: String(formData.get("company") ?? ""),
        consent: formData.get("consent") === "yes",
        source: "homepage",
      };

      status.textContent = "Joining…";
      submit?.setAttribute("disabled", "true");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "content-type": "application/json", "accept": "application/json" },
          body: JSON.stringify(payload),
        });
        const rawResult: unknown = await response.json().catch(() => ({}));
        const result: WaitlistResponse =
          typeof rawResult === "object" && rawResult !== null
            ? (rawResult as WaitlistResponse)
            : {};

        if (!response.ok) {
          throw new Error(result?.error || "Could not join right now.");
        }

        status.textContent = result?.existing
          ? "You’re already on the list."
          : "You’re in. We’ll only email when there’s something worth seeing.";
        form.reset();
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Could not join right now.";
      } finally {
        submit?.removeAttribute("disabled");
      }
    });
  </script>
</BaseLayout>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;
    padding: .9rem 0;
    background: linear-gradient(to bottom, rgba(5,5,7,.82), rgba(5,5,7,.36), transparent);
    backdrop-filter: blur(16px);
  }

  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 52px;
  }

  nav {
    display: flex;
    gap: 1.7rem;
    color: #a9a3b5;
    font-size: .86rem;
    font-weight: 650;
  }

  nav a, .footer-links a {
    transition: color .2s ease;
  }

  nav a:hover, .footer-links a:hover {
    color: white;
  }

  .nav-cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    padding: .72rem 1rem;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 999px;
    background: rgba(255,255,255,.07);
    font-size: .84rem;
    font-weight: 750;
    backdrop-filter: blur(18px);
  }

  .hero {
    position: relative;
    min-height: 100svh;
    padding: clamp(8.5rem, 14vw, 11rem) 0 5rem;
    overflow: hidden;
  }

  .hero::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.16), transparent);
  }

  .hero-glow {
    position: absolute;
    top: -30%;
    left: 45%;
    width: 70vw;
    height: 70vw;
    border-radius: 999px;
    background: radial-gradient(circle, rgba(124,58,237,.18), rgba(124,58,237,.03) 45%, transparent 68%);
    filter: blur(12px);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(470px, .9fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .hero-copy h1 {
    max-width: 820px;
    margin: 1.45rem 0 1.4rem;
    font-size: clamp(4rem, 8.5vw, 8rem);
    line-height: .87;
    letter-spacing: -.075em;
  }

  .hero-copy > p {
    max-width: 660px;
    margin: 0;
    color: #afa9bb;
    font-size: clamp(1.05rem, 1.7vw, 1.24rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    min-height: 50px;
    padding: 0 1.2rem;
    border-radius: 999px;
    font-size: .9rem;
    font-weight: 760;
    transition: transform .2s ease, background .2s ease, border-color .2s ease;
  }

  .button:hover { transform: translateY(-2px); }

  .button-primary {
    background: linear-gradient(135deg, #f7f4ff 0%, #c9b6ff 50%, #a278ff 100%);
    color: #120c1e;
    box-shadow: 0 14px 36px rgba(124,58,237,.28);
  }

  .button-ghost {
    border: 1px solid rgba(255,255,255,.13);
    background: rgba(255,255,255,.045);
  }

  .trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
    margin-top: 2rem;
    color: #777080;
    font-size: .77rem;
    font-weight: 650;
  }

  .trust-row span::before {
    margin-right: .45rem;
    content: "·";
    color: #9e7cff;
  }

  .ecosystem-stage {
    position: relative;
    min-height: 660px;
    perspective: 1200px;
  }

  .phone-shell {
    position: absolute;
    top: 3%;
    left: 50%;
    z-index: 3;
    width: min(320px, 65%);
    aspect-ratio: .505;
    padding: 8px;
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 3.1rem;
    background: linear-gradient(145deg, #2f2b38, #08080b 18%, #15121c 80%, #4c4357);
    box-shadow: 0 55px 100px rgba(0,0,0,.54), 0 0 90px rgba(124,58,237,.14);
    transform: translateX(-50%) rotateY(-8deg) rotateX(3deg);
  }

  .phone-screen {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    overflow: hidden;
    border-radius: 2.7rem;
    background: #09090d;
  }

  .phone-screen::before {
    position: absolute;
    top: .55rem;
    left: 50%;
    z-index: 4;
    width: 31%;
    height: 1.15rem;
    border-radius: 999px;
    content: "";
    background: #020204;
    transform: translateX(-50%);
  }

  .phone-top {
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2.35rem 1.2rem .8rem;
    font-size: .78rem;
    font-weight: 800;
  }

  .video-scene {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    padding: 1.1rem;
    background:
      radial-gradient(circle at 75% 25%, rgba(209,178,255,.8), transparent 25%),
      radial-gradient(circle at 32% 55%, rgba(74,56,166,.9), transparent 32%),
      linear-gradient(155deg, #191425 0%, #3a2763 48%, #130f1f 100%);
  }

  .video-scene::before {
    position: absolute;
    inset: 13% 18% 32%;
    border-radius: 45% 55% 48% 52%;
    content: "";
    background: linear-gradient(145deg, rgba(255,255,255,.45), rgba(174,111,255,.06));
    filter: blur(1px);
    box-shadow: 0 25px 60px rgba(0,0,0,.3);
    transform: rotate(-18deg);
  }

  .scene-copy {
    position: relative;
    z-index: 2;
    margin-bottom: 1rem;
  }

  .scene-tag {
    display: inline-block;
    margin-bottom: .55rem;
    padding: .35rem .55rem;
    border-radius: 999px;
    background: rgba(255,255,255,.13);
    font-size: .58rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .scene-copy h3 {
    max-width: 12ch;
    margin: 0;
    font-size: 1.85rem;
    line-height: 1;
    letter-spacing: -.055em;
  }

  .scene-copy p {
    max-width: 25ch;
    margin: .6rem 0 0;
    color: rgba(255,255,255,.68);
    font-size: .66rem;
    line-height: 1.45;
  }

  .product-float {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 42px 1fr auto;
    gap: .7rem;
    align-items: center;
    padding: .7rem;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 1rem;
    background: rgba(7,7,10,.64);
    backdrop-filter: blur(16px);
  }

  .product-thumb {
    aspect-ratio: 1;
    border-radius: .65rem;
    background: linear-gradient(145deg, #f8d2a1, #7c4f31);
  }

  .product-float strong, .product-float span {
    display: block;
    font-size: .64rem;
  }

  .product-float span {
    margin-top: .14rem;
    color: #a59fab;
  }

  .product-float button {
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 999px;
    background: white;
    color: #17121f;
    font-weight: 900;
  }

  .phone-nav {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: center;
    padding: .8rem .75rem 1.2rem;
    color: #827c8a;
    font-size: .78rem;
    text-align: center;
  }

  .phone-nav .create {
    display: inline-grid;
    width: 2.1rem;
    height: 1.6rem;
    place-items: center;
    margin: auto;
    border-radius: .45rem;
    background: white;
    color: #15121b;
    font-weight: 900;
  }

  .signal-card {
    position: absolute;
    z-index: 5;
    width: min(295px, 58%);
    border-radius: 1.3rem;
    padding: 1rem;
  }

  .signal-ai {
    top: 11%;
    left: -4%;
    transform: rotateY(10deg) rotateZ(-3deg);
  }

  .signal-head {
    display: flex;
    align-items: center;
