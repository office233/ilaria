+SELLER_WEBHOOK_JOBS_PER_RUN=30
+SELLER_WEBHOOK_SETUP_PER_RUN=2
+SELLER_RECONCILE_INTEGRATIONS_PER_RUN=2
+SELLER_RECONCILE_INTERVAL_HOURS=6
+SELLER_RECONCILE_MAX_PAGES_PER_RUN=3
+SELLER_RECONCILE_PAGE_SIZE=50
+
+# Fly provider-cost protection: identical searches are cached briefly; checkout
+# still performs a live price-check before payment.
+FLY_SEARCH_CACHE_TTL_SECONDS=60
+
 # SEO verificari
 GOOGLE_SITE_VERIFICATION=
 BING_SITE_VERIFICATION=
