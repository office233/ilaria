# Optional runtime settings. Existing process environment takes precedence.
SWYPIK_PORT=9876
SWYPIK_BIND_HOST=127.0.0.1
# Empty uses embedded assets; set ui/web for UI development.
SWYPIK_STATIC_DIR=
SWYPIK_WORKSPACE_DIR=.
SWYPIK_DEFAULT_URL=https://swypik.com
# The actual local port is allowed automatically. Additional origins must be trusted.
SWYPIK_ALLOWED_ORIGINS=
# Optional browser executable overrides.
SWYPIK_EDGE_PATH=
SWYPIK_CHROME_PATH=
SWYPIK_SWARM_ENABLED=true
SWYPIK_SWARM_NODE_ID=swypik_primary_node
SWYPIK_SWARM_REWARD_PER_TFLOP=0.10
SWYPIK_STATE_DIR=./data
# Experimental coordinator settings; cloud transport is not implemented.
SWYPIK_AZURE_COSMOS_ENDPOINT=
SWYPIK_AZURE_COSMOS_KEY=
SWYPIK_AZURE_DATABASE_NAME=SwypikSwarmDB
SWYPIK_AZURE_BLOB_STORAGE_URI=
SWYPIK_AZURE_OFFLINE_CACHE=./data/swarm_azure_cache.json
