    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:design": "node scripts/scan-design-debt.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "perf:budget": "node scripts/perf/budget.mjs",
    "test:platform": "node tools/test-platform.mjs",
    "test:workers": "node tools/test-workers.mjs",
    "test:dispatch": "node scripts/test-dispatch.mjs",
    "test:payments": "tsx scripts/test-payments.ts",
    "payouts:process": "node scripts/process-payouts.mjs",
    "worker:dispatch": "node scripts/dispatch-worker.mjs",
    "ci": "npm run lint && npm run lint:design && npm run typecheck && npm run build && npm run perf:budget && npm run test:platform && npm run test:workers",
    "ci:social": "npm run ci",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run"
  },
