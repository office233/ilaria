# Workspace-wide ignores. Product-specific rules live in swyp/.gitignore and
# swypik-os/.gitignore; ilaria rules are kept here, scoped to ilaria/.

# --- Build outputs and binaries ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.a
*.o
*.lib
*.exp
*.pdb
*.obj
*.test
/bin/
/build/

# --- Caches ---
.gocache/
.cache/
__pycache__/
.pytest_cache/

# --- Python virtual environments ---
.venv/
venv/
*-venv/

# --- Editors and OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Local agent/tool config (per-machine) ---
.mcp.json
.claude/settings.local.json
.claude/worktrees/
.superpowers/
# Downloaded local compiler/tool distributions are not project source.
/.tools/
/_conversatii-claude/

# Local credentials; sanitized examples remain reviewable.
.env
.env.*
!.env.example
!.env.template

# --- Model weights and checkpoints ---
*.pt
*.safetensors
*.ckpt
*.gguf

# --- Ilaria bulk / regenerable data ---
# Curated small files (ilaria/data/corpus/README.md, evals/,
# tokenizer*.json, training/, ...) stay trackable: only bulk dirs are ignored.
# Committed exception: ilaria/data/imc1b-azure-preparation/ (small prep reports).
ilaria/data/smoke/
ilaria/data/candidate-corpus/
ilaria/data/source-cache/
ilaria/data/colab/
ilaria/data/forge/
ilaria/data/production/
ilaria/data/candidate-tokenizer-sample/
ilaria/data/knowledge/
ilaria/data/candidate-corpus-regenerated/
ilaria/data/corpus/*.jsonl
ilaria/data/corpus/*.txt
!ilaria/data/corpus/general.jsonl
!ilaria/data/corpus/reasoning.jsonl

# Regenerable benchmark payloads/caches. Keep scripts, results, manifests and
# provenance records trackable; preserve all existing local files on disk.
ramasite/benchmarks/ilaria/**/*.sqlite
ramasite/benchmarks/ilaria/**/*.sqlite-journal
ramasite/benchmarks/ilaria/**/*.sqlite-wal
ramasite/benchmarks/ilaria/**/*.sqlite-shm
ramasite/benchmarks/ilaria/**/*.zip
ramasite/benchmarks/ilaria/**/*.bin
ramasite/benchmarks/ilaria/imc_125m_eval_frozen/*.jsonl
ramasite/benchmarks/ilaria/imc_125m_tokenizer_candidate/sample/*.txt

# Machine-local tools, conversations, environments and caches.
/ramasite/local/
/ramasite/benchmarks/**/build/
