// Opt-in semantic core: use core-run, ir/core-exec, or verify.
// The ordinary run/build/web/STV2 commands retain their original language.
fn next(x: i64) -> i64 {
    return x + 1;
}

fn square(x: i64) -> i64 {
    return x * x;
}

fn absolute(x: i64) -> i64 {
    if x < 0 {
        return -x;
    } else {
        return x;
    }
}

fn sum_to(n: i64) -> i64 {
    let total: i64 = 0;
    let i: i64 = 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fn half(x: f64) -> f64 {
    return x / 2;
}

fn main() {}
