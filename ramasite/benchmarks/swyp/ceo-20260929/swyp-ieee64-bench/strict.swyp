fn mandelbrot(width:f64)->f64 {
  let height:f64=width/2; let py:f64=0; let checksum:f64=0;
  while py<height { let px:f64=0; while px<width {
    let cr:f64=px*3.5/width-2.5; let ci:f64=py*2/height-1; let zr:f64=0; let zi:f64=0; let count:f64=0;
    while count<80 && zr*zr+zi*zi<=4 { let next:f64=zr*zr-zi*zi+cr; zi=2*zr*zi+ci; zr=next; count=count+1; }
    checksum=checksum+count; px=px+1; } py=py+1; }
  return checksum;
}
fn main(){}