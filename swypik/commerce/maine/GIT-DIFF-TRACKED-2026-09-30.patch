+ * Creează un grup Messenger. Creatorul este participant + admin.
+ * Toți ceilalți user IDs trebuie să existe; duplicatele sunt eliminate.
+ */
+export async function createGroupConversation(
+  creatorId: string,
+  title: string,
+  participantUserIds: string[],
+): Promise<{ conversationId: string }> {
+  const members = [...new Set(participantUserIds.filter((id) => id && id !== creatorId))];
+  if (!title.trim() || members.length < 2 || members.length + 1 > DM_CONFIG.maxGroupMembers) {
+    throw statusError("Invalid group participants", 400, "invalid_group");
+  }
+
+  return withTransaction(async (q) => {
+    const { rows: users } = await q<{ id: string }>(
+      `SELECT id FROM users
+        WHERE id = ANY($1::uuid[])
+          AND deleted_at IS NULL`,
+      [members],
+    );
+    if (users.length !== members.length) {
+      throw statusError("Group participant not found", 404, "participant_not_found");
+    }
+
+    const { rows: blocked } = await q(
+      `SELECT 1
+         FROM user_blocks
+        WHERE (blocker_user_id = $1 AND blocked_user_id = ANY($2::uuid[]))
+           OR (blocked_user_id = $1 AND blocker_user_id = ANY($2::uuid[]))
+        LIMIT 1`,
+      [creatorId, members],
+    );
+    if (blocked.length) throw statusError("Blocked participant", 403, "blocked");
+
+    const { rows } = await q<{ id: string }>(
+      `INSERT INTO conversations (kind, created_by, title)
+       VALUES ('group', $1, $2)
+       RETURNING id`,
+      [creatorId, title.trim()],
+    );
+    const conversationId = rows[0]?.id;
+    if (!conversationId) throw new Error("group_conversation_insert_failed");
+
+    await q(
+      `INSERT INTO conversation_participants (conversation_id, user_id, role, is_admin)
+       SELECT $1, id,
+              CASE WHEN id = $2 THEN 'admin' ELSE 'member' END,
+              id = $2
+         FROM users
+        WHERE id = ANY($3::uuid[])
+       ON CONFLICT DO NOTHING`,
+      [conversationId, creatorId, [creatorId, ...members]],
+    );
+    return { conversationId };
+  });
+}
