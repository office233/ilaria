// Swyp Lang: functions, arithmetic, strings, booleans, and loops.
fn square(x) {
    return x * x;
}

fn main() {
    print("Hello from Swyp Lang!");
    let count = 1;
    while count <= 5 {
        print("square", count, "=", square(count));
        count = count + 1;
    }
    if square(5) == 25 && true {
        print("All calculations passed.");
    } else {
        print("Unexpected result.");
    }
}
