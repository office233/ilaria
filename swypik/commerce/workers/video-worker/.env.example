# Queue: postgres (default, coada = tabelul video_processing_jobs) sau legacy stream/list.
VIDEO_QUEUE_BACKEND=postgres
# Gol → hostname:pid:random6 (unic per container).
VIDEO_WORKER_ID=
VIDEO_LEASE_SECONDS=120
VIDEO_POLL_INTERVAL_SECONDS=2
VIDEO_RETRY_BACKOFF_MAX_SECONDS=900
VIDEO_HEARTBEAT_FILE=/tmp/video-worker-heartbeat
# release (eliberează jobul la SIGTERM) sau finish (termină jobul curent)
VIDEO_SHUTDOWN_MODE=release

# Redis: optional in postgres mode (only the pub/sub wake-up signal); the queue itself for stream/list.
# nosemgrep: trailofbits.generic.redis-unencrypted-transport.redis-unencrypted-transport - local development Redis endpoint.
REDIS_URL=redis://localhost:6379/0
VIDEO_WAKEUP_CHANNEL=video:jobs:wakeup
# Legacy stream/list settings
VIDEO_QUEUE_NAME=video:jobs
VIDEO_CONSUMER_GROUP=video-workers
VIDEO_CONSUMER_NAME=local-video-worker
VIDEO_POLL_TIMEOUT_SECONDS=5
VIDEO_FAILED_STREAM=video:jobs:failed
VIDEO_ACK_FAILED_JOBS=false

# Postgres. Required for the postgres queue backend; for stream/list/--job-json, if unset, DB updates are skipped.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aicevrei
VIDEO_JOBS_TABLE=video_jobs
VIDEO_ASSETS_TABLE=video_assets

# R2 / S3-compatible storage
S3_BUCKET=aicevrei-videos
VIDEO_OUTPUT_BUCKET=aicevrei-videos
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_BASE_URL=https://cdn.example.com
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
AWS_REGION=auto

# Processing
# Scara de calitate pe latura SCURTA (short_side:bitrate); fara upscaling, aspect pastrat.
VIDEO_LADDER=360:800k,540:1400k,720:2800k,1080:5000k
# libx264 (CPU) sau h264_nvenc (GPU NVIDIA + ffmpeg cu --enable-nvenc)
VIDEO_ENCODER=libx264
VIDEO_MIN_DURATION_MS=1000
VIDEO_MAX_DURATION_MS=180000
VIDEO_MAX_ATTEMPTS=3
VIDEO_RETRY_BACKOFF_SECONDS=5
FFMPEG_TIMEOUT_SECONDS=900
VIDEO_WORK_DIR=

# Azure AI (optional): Whisper captions + thumbnail moderation (video_worker/ai_hooks.py)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
CONTENT_SAFETY_IMAGE_REVIEW_AT=2
CONTENT_SAFETY_IMAGE_BLOCK_AT=4
VIDEO_AUTO_CAPTIONS=1
VIDEO_IMAGE_MODERATION=1
