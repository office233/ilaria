        "memory.write"
      ],
      "states": [
        {
          "name": "episodes",
          "type": "EpisodicStore"
        }
      ],
      "invariants": [
        "personal episodic memory remains local by default",
        "global training has no implicit access to personal memory"
      ]
    },
    {
      "kind": "component",
      "name": "CorticalConnectome",
      "capabilities": [
        "registry.read",
        "connectome.write_verified"
