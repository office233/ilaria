{
  "version": 1,
  "declarations": [
    {
      "kind": "component",
      "name": "BrokerEffectsV1",
      "invariants": [
        "guest effect requirements name authority but never grant it",
        "the host binds each request to an authenticated lease and scoped grant",
        "only clock.read and fs.read are supported by version one",
        "uncertain or completed intents are never blindly replayed",
        "execution receipts do not confer training eligibility",
        "preflight executes no guest effects and pins a canonical Core IR snapshot",
        "continuation checkpoints carry VM state but no authority and require host authentication before resume",
        "a checkpoint is emitted only after the corresponding effect result has been incorporated"
      ]
    },
    {
      "kind": "record",
      "name": "EffectPlan",
