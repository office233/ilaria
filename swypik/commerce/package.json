{
  "name": "swypik",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:social": "docker compose -f docker-compose.social.yml up",
    "dev:platform": "cd services/platform-api && go run ./cmd/api",
    "postinstall": "node scripts/patch-next-notfound-ssr.mjs",
