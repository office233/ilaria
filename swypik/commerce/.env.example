# ============================================================
# Swypik — variabile de mediu (exemplu)
# Copiază în .env.local pentru dev; pe VPS setează-le în mediul
# containerului. Vezi docs/DEPLOY.md + scripts/check-env.mjs.
# ============================================================

# --- Obligatorii (aplicația nu funcționează corect fără ele) ---
DATABASE_URL=postgresql://swypik:parola@localhost:5432/swypik
REDIS_URL=redis://localhost:6379
SESSION_SECRET=
# Criptare tokenuri/sesiuni sociale + semnături unsubscribe (32+ bytes hex)
APP_ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Plăți (obligatorii în producție) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend; fără cheie => doar log în consolă) ---
RESEND_API_KEY=

# --- AI: Azure AI Foundry (EU Data Zone) — lib/ai/azure ---
# API v1: POST {endpoint}/openai/v1/chat/completions, header api-key, model = deployment
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# model de tip reasoning (max_completion_tokens, fara temperature)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
# Whisper (subtitrari, max 25 MB/fisier)
AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
# optional: text-embedding-3-small (1536 dim) pentru cautarea semantica; gol = oprita
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# optional: minimal|low|medium|high (netrimis daca e gol)
AZURE_OPENAI_REASONING_EFFORT=
# Content Safety (F0: text:analyze + image:analyze, api-version 2024-09-01)
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# praguri de severitate (0..7): review = coada de moderare, block = respins
CONTENT_SAFETY_TEXT_REVIEW_AT=4
CONTENT_SAFETY_TEXT_BLOCK_AT=6
CONTENT_SAFETY_IMAGE_REVIEW_AT=2
CONTENT_SAFETY_IMAGE_BLOCK_AT=4
# optionale: AZURE_AI_CHAT_TIMEOUT_MS, AZURE_AI_TRANSCRIBE_TIMEOUT_MS, AZURE_AI_SAFETY_TIMEOUT_MS,
# AZURE_AI_MAX_ATTEMPTS (3), AZURE_AI_MAX_RETRY_WAIT_MS (8000)
# video-worker: VIDEO_AUTO_CAPTIONS / VIDEO_IMAGE_MODERATION (implicit pornite daca Azure e configurat)

# --- StudiAI: DOAR scripturile offline din scripts/data + scripts/eval (nu runtime) ---
STUDIAI_API_KEY=

# --- Social API proxy ---
SOCIAL_API_URL=

# Flights (Swypik Fly)
DUFFEL_API_KEY=

# --- Cloudflare Realtime (docs/infra/realtime.md) --------------------------
# Live shopping (1 host -> many viewers): Realtime SFU app. The App Secret is
# server-only; browsers signal through /api/live/streams/[id]/{publish,watch,heartbeat}.
CF_REALTIME_APP_ID=
CF_REALTIME_APP_TOKEN=
# Optional TURN key (short-lived ICE credentials for restrictive networks).
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=
# CF_TURN_CREDENTIAL_TTL=14400
# Live heartbeat: stream ends when the host misses heartbeats for this many seconds.
# LIVE_HEARTBEAT_TTL=20
# LIVE_HEARTBEAT_INTERVAL_MS=7000
# Messenger calls (1:1 / small group): RealtimeKit. API token needs the
# "Realtime" / "Realtime Admin" permission. Presets must exist in the app.
CF_REALTIMEKIT_ACCOUNT_ID=
CF_REALTIMEKIT_APP_ID=
CF_REALTIMEKIT_API_TOKEN=
CF_REALTIMEKIT_PRESET_VIDEO=swypik_call_video
CF_REALTIMEKIT_PRESET_AUDIO=swypik_call_audio
# Optional: pin the webhook public key (PEM, 
 allowed); otherwise it is fetched
# from https://api.realtime.cloudflare.com/.well-known/webhooks.json and cached.
CF_REALTIMEKIT_WEBHOOK_PUBLIC_KEY=
# Build-time: show the call buttons (set to 1 only when the CF_REALTIMEKIT_* keys exist).
NEXT_PUBLIC_CALLS_ENABLED=

# RateHawk (Emerging Travel Group) � caz�ri B2B; dac� e setat, are prioritate fa?� de Duffel Stays
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
DUFFEL_API_URL=https://api.duffel.com
KIWI_TEQUILA_API_KEY=
FLY_MARKUP_CENTS=200

# Pricing engine (FRONT R3) — Google Directions opțional; fallback haversine
GOOGLE_MAPS_API_KEY=

# Plăți & payout (FRONT R5)
# Prag minim retragere curieri, în cenți (default 5000 = 50 RON)
PAYOUT_MIN_CENTS=5000
# Fereastra de retur (zile) — payout-urile seller se procesează după expirare (default 14)
RETURN_WINDOW_DAYS=14
# Scor minim de calitate pentru feed-ul de produse (default 40)
FEED_MIN_SWYPIK_SCORE=40
# Contul tehnic al platformei pentru comisioane în wallet_ledger
# (implicit id-ul determinist din migrarea 20260730_0013)
PLATFORM_USER_ID=

# Comision creator, în basis points (500 = 5%)
CREATOR_COMMISSION_BPS=500

# Fus orar implicit al platformei (IANA)
DEFAULT_TIMEZONE=Europe/Bucharest

# Push web (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@swypik.com

# Obligatorii �n produc?ie (fallback-uri doar �n dev)
CRON_SECRET=
OAUTH_REDIRECT_BASE=
STUDIAI_BASE_URL=
GO_API_URL=
FEED_EVENT_IP_SALT=


# Fly market intelligence (DOAR date de pret, zero linkuri afiliere)
TRAVELPAYOUTS_TOKEN=
FLY_FX_BUFFER_PCT=1.5
# Fallback rates (JSON format) in case all other sources fail; example: {"EUR":4.97,"GBP":5.85,"USD":4.55}
FX_FALLBACK_RATES=

# ��� Adaugat 2026-07-31 (audit env � variabile folosite in cod dar nedocumentate) ���

# URL-uri de baza
APP_URL=https://swypik.com
BASE_URL=https://swypik.com
SITE_URL=https://swypik.com
NEXT_PUBLIC_BASE_URL=https://swypik.com
NEXT_PUBLIC_SITE_URL=https://swypik.com
INTERNAL_APP_URL=http://web-next:3000

# Admin & secrete interne
# Adminii intră cu contul lor (users.role=admin, login OTP); ADMIN_SECRET e doar
# pentru mașini (Authorization: Bearer … din scripturi/cron) și acces de urgență.
ADMIN_SECRET=
# Acces de urgență în /admin cu ADMIN_SECRET + emailul unui admin (1 = activ; implicit oprit)
ADMIN_BREAK_GLASS_ENABLED=
# Durata sesiunii de admin în ore (implicit 12, maxim 168)
ADMIN_SESSION_TTL_HOURS=
# Zile de suspendare la „ban creator” din coada de moderare (implicit 7)
MODERATION_BAN_DAYS=
INTERNAL_HEALTH_SECRET=
PLATFORM_API_SECRET=
NEXTAUTH_SECRET=
SUPPLIER_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Email & alerte operationale
EMAIL_FROM=Swypik <no-reply@swypik.com>
SUPPORT_EMAIL=support@swypik.com
OPS_ALERT_EMAIL=
ADMIN_ALERT_EMAIL=
DISPUTE_ALERT_EMAIL=
VIDEO_ALERT_EMAIL=
OPS_ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=

# OAuth (Google/Apple)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_OAUTH_APPLE_ENABLED=false

# App links (aplicațiile Capacitor) — /.well-known/* răspund 404 cât timp lipsesc.
# iOS: APPLE_TEAM_ID (de mai sus) + bundle id-urile, separate prin virgulă.
IOS_BUNDLE_IDS=
# Android: pachet=amprente SHA-256 (Play Console → App signing), separate prin |;
# aplicațiile separate prin ; — ex. com.swypik.app=AA:BB:...:FF
ANDROID_APP_LINKS=

# AI / LLM: vezi sectiunea Azure AI Foundry de mai sus. StudiAI doar pentru scripts/data:
STUDIAI_API_KEYS=
STUDIAI_MODEL=

# Comert & comisioane (bps: 1% = 100)
PLATFORM_COMMISSION_BPS=1000
CREATOR_COMMISSION_BPS_RATE=500
STAYS_COMMISSION_PCT=10
STAYS_FREE_CANCEL_DAYS=2
FLY_MARKUP_PCT=10
FLY_MARKUP_MIN_CENTS=
FLY_MARKUP_FLOOR_RON=

# Video pipeline (alerte + watchdog � au default-uri rezonabile in cod)
REDIS_STREAM_VIDEO_JOBS=
VIDEO_QUEUE_NAME=
VIDEO_CONSUMER_GROUP=
VIDEO_FAILED_STREAM=

# Integrari
NOMINATIM_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SOCIAL_API_URL=

# SEO verificari
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
BING_URL_SUBMISSION_API_KEY=
INDEXNOW_KEY=
YANDEX_VERIFICATION=
PINTEREST_SITE_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=

# Operational
LOG_LEVEL=info
RATE_LIMIT_REDIS_REQUIRED=true
# Sentry. ATENȚIE la momentul citirii:
#   SENTRY_DSN                            → RUNTIME (instrumentation.ts, server)
#   NEXT_PUBLIC_SENTRY_DSN                → BUILD-TIME, se coace în bundle
#   NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE → BUILD-TIME
# Cele NEXT_PUBLIC_* cer REBUILD, nu restart. Sunt transmise ca build args în
# infra/hetzner/docker-compose.prod.yml. Fără build arg ajung "" în bundle și
# Sentry tace în browser, fără niciun avertisment.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
FEATURE_STRIPE_CONNECT=false
FEATURE_DM=false
NEXT_PUBLIC_FEATURE_DM=false
NEXT_PUBLIC_FEATURE_TRY_ON=false
# Preferred over the legacy TRY_ON flag above — see lib/feature-flags-client.ts
NEXT_PUBLIC_FEATURE_VIRTUAL_TRYON=false
NEXT_PUBLIC_FEATURE_VISUAL_SEARCH=false

# Centrul implicit al hartilor (lat,lng) - fallback cand nu avem locatia userului
NEXT_PUBLIC_DEFAULT_MAP_CENTER=44.4268,26.1025
# Fusul orar implicit al platformei (IANA)
DEFAULT_TIMEZONE=Europe/Bucharest
# UUID-ul contului oficial Swypik (difera intre medii; vezi lib/config/accounts.ts)
NEXT_PUBLIC_SWYPIK_OFFICIAL_USER_ID=
# Adrese contact publice
SUPPORT_EMAIL=support@swypik.com
PRIVACY_EMAIL=privacy@swypik.com
HELLO_EMAIL=hello@swypik.com

# Fraud/Referral tuning (optional; defaults in cod)
FRAUD_REVIEW_SCORE=50
FRAUD_BLOCK_SCORE=70
REFERRAL_DAILY_CAP=3
REFERRAL_MIN_SCORE=0.5

# --- Media storage: S3-compatibil (MinIO local, Cloudflare R2 in productie) ---
# Detalii, CORS, Cache Rules, Worker: docs/infra/r2.md. Niciun byte de media nu trece prin app.
# Endpointul S3 vazut de server (R2: https://<account-id>.r2.cloudflarestorage.com; local: http://localhost:9000)
S3_ENDPOINT=
# R2: auto
S3_REGION=auto
S3_BUCKET=
# R2: token API "Object Read & Write" limitat la bucket-ul de media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Endpointul pe care se semneaza URL-urile de upload direct din browser (implicit S3_ENDPOINT;
# pe R2 lasa gol). Alias vechi: S3_UPLOAD_PUBLIC_ENDPOINT.
S3_PRESIGN_ENDPOINT=
# Originea CDN publica a media (domeniul custom R2), fara "/" final, ex. https://media.swypik.com.
# Aliasuri vechi acceptate: S3_PUBLIC_URL, S3_PUBLIC_BASE_URL, R2_PUBLIC_URL. Necesar si la BUILD (CSP).
MEDIA_PUBLIC_BASE_URL=
# Aceeasi valoare, pentru browser (loader-ul next/image; se coace la build)
NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=
# "cloudflare" = redimensionare prin Cloudflare Image Transformations pe domeniul media; gol = URL-ul original
NEXT_PUBLIC_MEDIA_IMAGE_TRANSFORM=
# Media privata/platita: secretul comun cu Worker-ul infra/cloudflare/media-worker (openssl rand -base64 48)
MEDIA_SIGNING_SECRET=
# Originea URL-urilor semnate (domeniul unde ruleaza Worker-ul); implicit MEDIA_PUBLIC_BASE_URL
MEDIA_SIGNED_BASE_URL=
# Prefixul cheilor fara acces public direct (Worker-ul raspunde 403 pe el)
MEDIA_PRIVATE_PREFIX=private/
# Doar urgenta: 1 = reporneste proxy-ul de bytes din app in productie (costa egress pe VM!)
MEDIA_SERVER_PROXY=
# Backup nocturn Postgres -> R2 (infra/azure/backup-db.sh): bucket separat, token separat
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=postgres/
BACKUP_RETENTION_DAYS=14

# --- Audit 2026-08-05: env vars folosite �n cod, documentate acum ---
# FX API (cron refresh-fx)
FX_API_URL=
FX_API_ACCESS_KEY=
# Cron/infra
CRON_INTERNAL_BASE=http://localhost:3000
DISPUTE_ALERT_COOLDOWN_HOURS=24
TRACKING_URL_TEMPLATE=
PINO_PRETTY=false
# Build metadata (setate de scriptul de deploy)
BUILD_COMMIT=
BUILD_TIME=
GIT_COMMIT=
DEPLOYED_AT=
# AUTH_SECRET � alias legacy pentru SESSION_SECRET (folosit �n unele rute)
AUTH_SECRET=
# Video pipeline alerting/watchdog (defaults �n cod)
VIDEO_ALERT_COOLDOWN_MIN=30
VIDEO_ALERT_DB_QUEUED=25
VIDEO_ALERT_QUEUE_FAILED=5
VIDEO_ALERT_QUEUE_LAG=100
VIDEO_ALERT_QUEUE_LEN=50
VIDEO_ALERT_QUEUE_PENDING=20
VIDEO_ALERT_STALE_MIN=60
VIDEO_ALERT_STALE_THRESHOLD=3
VIDEO_STATS_AGGREGATE_DAYS=7
VIDEO_STATS_SYNC_COUNTERS=true
VIDEO_WATCHDOG_MAX_ATTEMPTS=3
VIDEO_WATCHDOG_REENQUEUE_BATCH=20
VIDEO_WATCHDOG_STALE_QUEUED_MIN=30
VIDEO_WATCHDOG_STALE_RUNNING_MIN=30

# ── Adăugate 2026-09-21 (curățenie post-Antigravity) ─────────────────────────
# Catalog demo „viral" pentru selleri (date de exemplu, nu feed de furnizor). OFF.
FEATURE_VIRAL_CATALOG=false
NEXT_PUBLIC_FEATURE_VIRAL_CATALOG=false
# Swypik Cares (donații) — OFF până există un partener ONG (server + client).
FEATURE_CARES=false
NEXT_PUBLIC_FEATURE_CARES=false
# Rutare pe străzi pentru hartă (OSRM). Fără valoare => linie dreaptă.
# NU folosi https://router.project-osrm.org în producție (server demo, fără SLA).
NEXT_PUBLIC_OSRM_URL=
# Furnizor tile-uri hartă (implicit OSM HOT). Ex: https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=
# Plafon per interogare Postgres (ms), vezi lib/db.ts.
PG_STATEMENT_TIMEOUT_MS=30000
# Pool pg per replică (replici × PG_POOL_MAX ≤ max_connections, docs/infra/scaling.md) și timeout inactiv (ms).
PG_POOL_MAX=15
PG_IDLE_TIMEOUT_MS=30000
# Fișierul de date al Nodului Local desktop (implicit în directorul de date al userului).
SWYPIK_LOCAL_NODE_DB=

# ── Swypik Movies ───────────────────────────────────────────────────────────
FEATURE_MOVIES=false
NEXT_PUBLIC_FEATURE_MOVIES=false
MOVIES_CREATOR_SHARE_BPS=7000
MOVIES_SEASON_DISCOUNT_PCT=40
# Coloană legacy, neutilizată: valoare fixă pt. constrângerea NOT NULL a schemei DB vechi.
MOVIES_DEFAULT_EPISODE_PRICE_UNITS=500
MOVIES_DEFAULT_FREE_EPISODES=3
MOVIES_MAX_EPISODE_DURATION_MS=180000
MOVIES_STREAM_TOKEN_TTL_S=600

# Swypik Music (FEATURE_MUSIC) — artiști aprobați, piese premium deblocate cu cardul (RON)
FEATURE_MUSIC=false
NEXT_PUBLIC_FEATURE_MUSIC=false
MUSIC_ARTIST_SHARE_BPS=7000
MUSIC_ALBUM_DISCOUNT_PCT=30
# Coloană legacy, neutilizată: valoare fixă pt. constrângerea NOT NULL a schemei DB vechi.
MUSIC_TRACK_PRICE_MIN_UNITS=100
MUSIC_MAX_UPLOAD_MB=40
MUSIC_MAX_DURATION_MIN=30
MUSIC_STREAM_TOKEN_TTL_S=900
# Jamendo (Creative Commons tracks) - optional, vezi lib/audio/jamendo.ts
JAMENDO_CLIENT_ID=

# ── Swypik AI News (FEATURE_NEWS) — stiri autonome, fact-checked ───────────
FEATURE_NEWS=false
NEXT_PUBLIC_FEATURE_NEWS=false
# lib/news/ai-journalist.ts foloseste Azure OpenAI (AZURE_OPENAI_*, sectiunea AI de mai sus).
# Deployment-ul: NEWS_AI_DEPLOYMENT, altfel AZURE_OPENAI_CHAT_DEPLOYMENT (fara default in cod).
# Fara endpoint/cheie/deployment, cron-ul news-pipeline raspunde 503 si nu publica nimic.
NEWS_AI_DEPLOYMENT=
# auto = rezumatele validate se publica direct; review = raman ciorne pentru /admin/news
NEWS_PUBLISH_MODE=auto
# Plafoane de siguranta LLM (lib/news/config.ts) — optionale, au default-uri sanatoase
NEWS_MAX_ARTICLES_PER_RUN=8
NEWS_MAX_ARTICLES_PER_DAY=60
NEWS_MAX_SOURCES_PER_RUN=8
NEWS_ITEMS_PER_FEED=3
NEWS_FETCH_TIMEOUT_MS=5000
NEWS_AI_TIMEOUT_MS=20000
NEWS_MAX_ATTEMPTS_PER_ITEM=3

# ── Swypik Arcade (FEATURE_GAMING) — mini-jocuri & trivia ──────────────────
FEATURE_GAMING=false
NEXT_PUBLIC_FEATURE_GAMING=false

# ── Swypik Messenger (FEATURE_MESSENGER) — mesaje & apeluri video ──────────
FEATURE_MESSENGER=false
NEXT_PUBLIC_FEATURE_MESSENGER=false

# ── Performanță (w6-performance) ────────────────────────────────────────────
# Compresia o face Cloudflare; 1 = Next comprimă singur (deploy fără Cloudflare).
NEXT_COMPRESS=
# RUM propriu (POST /api/vitals): fracțiunea de vizite care raportează Web Vitals (0–1, implicit 0.5).
NEXT_PUBLIC_VITALS_SAMPLE_RATE=0.5
# Preîncălzirea cataloagelor externe în Redis (cron prewarm-catalogs, lib/prewarm/config.ts).
PREWARM_INTERVAL_MS=900000
PREWARM_HARD_TTL_S=604800
PREWARM_REDIS_TIMEOUT_MS=250
PREWARM_FETCH_TIMEOUT_MS=20000
PREWARM_REFRESH_LOCK_S=60
