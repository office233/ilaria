+# Timeout pentru apelurile externe de import; valid 1000..60000 ms.
+CATALOG_IMPORT_HTTP_TIMEOUT_MS=15000
+# Câte variante externe citim per produs într-un batch (maxim intern 50).
+CATALOG_IMPORT_MAX_VARIANTS=50
